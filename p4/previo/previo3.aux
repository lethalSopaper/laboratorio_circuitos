\@writefile{toc}{\contentsline {section}{\numberline {1}Encontrar las expresiones para \(S_{3 \phi }\), \(P_{3 \phi }\) y \(Q_{3 \phi }\), para una carga equilibrada conectada en Delta.}{1}{section.1}\protected@file@percent }
